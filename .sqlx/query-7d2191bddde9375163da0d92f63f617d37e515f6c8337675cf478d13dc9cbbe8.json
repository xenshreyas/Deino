  "query": "-- A meeting's (?1) speakers by label. Served by the UNIQUE (meeting_id, label)\n-- index (asserted in speaker_repo_tests.rs).\nSELECT\n    id AS \"id: SpeakerId\",\n    meeting_id AS \"meeting_id: MeetingId\",\n    label,\n    person_id AS \"person_id: PersonId\",\n    is_me AS \"is_me: bool\",\n    color AS \"color: PaletteColor\"\nFROM speakers\nWHERE meeting_id = ?1\nORDER BY label\n",
