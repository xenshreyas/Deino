  "db_name": "SQLite",
  "query": "-- Every person not merged into another, by name. Served by the partial\n-- index idx_people_listed_name (asserted in repo_tests.rs).\nSELECT\n    id AS \"id: PersonId\",\n    name,\n    email AS \"email: Email\",\n    company_id AS \"company_id: CompanyId\",\n    title,\n    avatar_path,\n    notes_md,\n    summary_md,\n    summary_updated_at AS \"summary_updated_at: DateTime<Utc>\",\n    is_me AS \"is_me: bool\",\n    merged_into AS \"merged_into: PersonId\",\n    created_at AS \"created_at: DateTime<Utc>\",\n    updated_at AS \"updated_at: DateTime<Utc>\"\nFROM people\nWHERE merged_into IS NULL\nORDER BY name COLLATE NOCASE, id\n",
