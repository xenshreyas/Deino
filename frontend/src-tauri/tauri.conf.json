{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Deino",
    "version": "0.4.1",
    "identifier": "com.xenshreyas.deino",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Deino",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": { "x": 16, "y": 24 }
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' ipc: http://ipc.localhost asset:"
            },
            "devCsp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' ipc: http://ipc.localhost asset: ws://localhost:3118 http://localhost:3118"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/recordings/**",
                    "$APPDATA/meetings/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg",
            "binaries/cli"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": { "schemes": ["deino"] }
        }
    }
}
