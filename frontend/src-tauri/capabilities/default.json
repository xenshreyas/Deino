{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main",
    "description": "Main window: file system, media, notifications and every feature plugin",
    "windows": [
        "main"
    ],
    "permissions": [
        "fs:default",
        "fs:allow-read-file",
        "fs:read-all",
        "fs:write-all",
        "fs:allow-app-read",
        "fs:allow-app-write",
        "fs:allow-download-write",
        "fs:allow-download-read",
        "fs:scope-download",
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "core:app:default",
        "core:resources:default",
        "core:menu:default",
        "core:tray:default",
        "core:window:allow-set-title",
        "core:window:allow-set-theme",
        "core:window:allow-start-dragging",
        "notification:default",
        "notification:allow-is-permission-granted",
        "updater:default",
        "process:default",
        {
            "identifier": "fs:scope",
            "allow": [
                {
                    "path": "$APPDATA/*"
                }
            ]
        },
        "system:default",
        "detection:default",
        "developer:default",
        "onboarding:default",
        "action-items:default",
        "calendar:default",
        "companies:default",
        "meetings:default",
        "export:default",
        "network:default",
        "pipeline:default",
        "profile:default",
        "search:default",
        "notes:default",
        "people:default",
        "recording:default",
        "secrets:default",
        "llm:default",
        "settings:default",
        "templates:default",
        "enhance:default",
        "transcription:default",
        "folders:default",
        "integrations:default",
        "insights:default",
        "tags:default",
        "speakers:default",
        "stats:default",
        "transcript:default",
        "vocabulary:default",
        "speaker-tags:default"
    ]
}
