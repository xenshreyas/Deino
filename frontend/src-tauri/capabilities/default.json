{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main",
    "description": "Main window: windows, notifications, the updater and every feature plugin",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "core:app:default",
        "core:resources:default",
        "core:menu:default",
        "core:tray:default",
        "core:window:allow-set-title",
        "core:window:allow-set-theme",
        "core:window:allow-start-dragging",
        "notification:default",
        "notification:allow-is-permission-granted",
        "updater:default",
        "process:default",
        "system:default",
        "detection:default",
        "developer:default",
        "onboarding:default",
        "action-items:default",
        "calendar:default",
        "companies:default",
        "meetings:default",
        "export:default",
        "network:default",
        "pipeline:default",
        "profile:default",
        "search:default",
        "notes:default",
        "people:default",
        "recording:default",
        "secrets:default",
        "llm:default",
        "settings:default",
        "privacy:default",
        "templates:default",
        "enhance:default",
        "transcription:default",
        "folders:default",
        "integrations:default",
        "insights:default",
        "import:default",
        "tags:default",
        "speakers:default",
        "stats:default",
        "transcript:default",
        "vocabulary:default",
        "speaker-tags:default",
        "player:default"
    ]
}
