{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main",
    "description": "Main window: windows, notifications and the updater. build.rs (build/features.rs) generates the grant of every feature plugin.",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "core:app:default",
        "core:resources:default",
        "core:menu:default",
        "core:tray:default",
        "core:window:allow-set-title",
        "core:window:allow-set-theme",
        "core:window:allow-start-dragging",
        "notification:default",
        "notification:allow-is-permission-granted",
        "updater:default",
        "process:default"
    ]
}
