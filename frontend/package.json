        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "6.0.1",
        "eslint": "9.39.4",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-sonarjs": "4.2.1",
        "globals": "17.12.0",
        "happy-dom": "20.14.5",
        "prettier": "3.9.8",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.2.2",
        "tw-animate-css": "1.4.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "8.58.1",
        "vite": "8.0.16",
        "vitest": "5.0.0"
    }
}
