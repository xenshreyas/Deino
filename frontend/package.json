{
    "name": "deino",
    "version": "0.4.1",
    "private": true,
    "packageManager": "pnpm@10.26.2",
    "scripts": {
        "dev": "vite",
        "dev:mock": "vite --mode mock",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit -p tsconfig.legacy.json && node scripts/typecheck.mjs && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint .",
        "format": "node scripts/format.mjs --write",
        "format:check": "node scripts/format.mjs --check",
        "tauri": "tauri",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:cuda": "tauri dev -- --features cuda",
        "tauri:dev:vulkan": "tauri dev -- --features vulkan",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:coreml": "tauri dev -- --features coreml",
        "tauri:dev:openblas": "tauri dev -- --features openblas",
        "tauri:dev:hipblas": "tauri dev -- --features hipblas",
        "tauri:build:cpu": "tauri build",
        "tauri:build:cuda": "tauri build -- --features cuda",
        "tauri:build:vulkan": "tauri build -- --features vulkan",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:coreml": "tauri build -- --features coreml",
        "tauri:build:openblas": "tauri build -- --features openblas",
        "tauri:build:hipblas": "tauri build -- --features hipblas"
    },
    "dependencies": {
        "@blocknote/core": "0.36.0",
        "@blocknote/react": "0.36.0",
        "@blocknote/shadcn": "0.36.0",
        "@fontsource-variable/inter": "5.3.0",
        "@hookform/resolvers": "^5.1.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "5.103.2",
        "@tanstack/react-router": "1.168.19",
        "@tanstack/react-virtual": "^3.13.13",
        "@tauri-apps/api": "^2.6.0",
        "@tauri-apps/plugin-fs": "^2.4.0",
        "@tauri-apps/plugin-notification": "~2.3.1",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-process": "^2.3.0",
        "@tauri-apps/plugin-updater": "^2.3.0",
        "@types/lodash": "^4.17.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^11.15.0",
        "lodash": "^4.17.21",
        "lucide-react": "^0.469.0",
        "radix-ui": "^1.4.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.59.0",
        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "zod": "^3.25.71",
        "zustand": "5.0.15"
    },
    "pnpm": {
        "overrides": {
            "prosemirror-model": "1.25.3",
            "prosemirror-state": "1.4.3",
            "prosemirror-view": "1.41.3",
            "prosemirror-transform": "1.10.4",
            "prosemirror-tables": "1.8.1"
        }
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@playwright/test": "1.62.1",
        "@tailwindcss/typography": "0.5.19",
        "@tailwindcss/vite": "4.2.2",
        "@tanstack/eslint-plugin-query": "5.103.2",
        "@tanstack/router-plugin": "1.167.19",
        "@tauri-apps/cli": "^2.1.0",
        "@tauri-apps/plugin-fs": "~2.4.0",
