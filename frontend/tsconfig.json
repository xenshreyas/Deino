{
  // The app's TypeScript config, with every PARITY_PLAN §3A flag on. Editors
  // use it. `pnpm typecheck` runs it through scripts/typecheck.mjs, which
  // fails on any error outside the legacy paths in legacy-files.mjs, and runs
  // tsconfig.legacy.json (these flags without the two newest) over everything.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"]
}
